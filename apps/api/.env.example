# Postgres connection string (local dev)
DATABASE_URL="postgresql://cargolens:cargolens_dev@localhost:5432/cargolens_dev"

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=8h
COOKIE_NAME=cargolens_session

# Server
PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# AI provider: "gemini" uses the real API, "demo" forces the deterministic fallback adapter
AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# File storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
